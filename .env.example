IQ_DB_SERVER=localhost
IQ_DB_PORT=1433
IQ_DB_NAME=otodatawebportal_dev
# auto => SQL auth when IQ_DB_USER is set, otherwise Windows integrated auth.
# sql => always use IQ_DB_USER/IQ_DB_PASSWORD.
# windows => always use Trusted_Connection=yes.
IQ_DB_AUTH_MODE=auto
IQ_DB_USER=sa
IQ_DB_PASSWORD=your_password_here
IQ_DB_DRIVER=ODBC Driver 18 for SQL Server
IQ_DB_TRUST_CERT=true

# Data source mode (required): all app datasets are read from IQ_SOURCE_TABLE.
IQ_SOURCE_MODE=flat-table

# Set true to use the synthetic demo_data.csv instead of connecting to SQL Server.
# Demo mode never reads from the database.
IQ_DEMO_MODE=true
IQ_DEMO_CSV=demo_data.csv

# Source table can be qualified as schema.table and support spaces.
IQ_SOURCE_TABLE=dbo.Insight Project
# Map these names to columns that exist in the flat table. Empty mappings make
# dependent analyses show a readiness message instead of querying guessed fields.
IQ_COL_DEVICE=Id
IQ_COL_LOCATION=
IQ_COL_INSTALLED_AT=TankInstallDate
IQ_COL_CUSTOMER=CompanyId
IQ_COL_LATITUDE=Latitude
IQ_COL_LONGITUDE=Longitude
IQ_COL_TERRITORY=
IQ_COL_SALES_DATE=PurchaseDate
IQ_COL_SALES_AMOUNT=
IQ_COL_SHIPPED_AT=
IQ_COL_SHIPPING_KEY=Id
IQ_COL_CUSTOMER_SIZE=
IQ_COL_PRODUCT_TYPE=DeviceType
IQ_COL_RATE_DENOMINATOR=
IQ_COL_MARKET_INDICATOR=
IQ_COL_MARKET_INDICATOR_AT=
IQ_COL_INVENTORY_ITEM=
IQ_COL_INVENTORY_AS_OF=
IQ_COL_INVENTORY_ON_HAND=
IQ_COL_INVENTORY_DEMAND=
IQ_COL_REPLENISHMENT_DAYS=
IQ_COL_REORDER_POINT=
IQ_COL_MAX_STOCK=

# OpenAI (private fixed-label mode works without external-data opt-in)
IQ_OPENAI_API_KEY=
IQ_OPENAI_MODEL=gpt-4o-mini
# Guided mode sends approved questions and, separately, approved safe aggregates.
# Review your organization's policy/provider terms before enabling.
IQ_AI_ALLOW_EXTERNAL_DATA=false
# Database mode only: attest that IQ_DB_* uses a SELECT-only account restricted
# to IQ_SOURCE_TABLE (prefer an authorized view). Never use sa for guided mode.
# This flag does not grant/restrict permissions; enforce them in SQL Server.
IQ_AI_DB_READ_ONLY_CONFIRMED=false
