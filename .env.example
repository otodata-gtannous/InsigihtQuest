IQ_DB_SERVER=localhost
IQ_DB_PORT=1433
IQ_DB_NAME=otodatawebportal_dev
# auto => SQL auth when IQ_DB_USER is set, otherwise Windows integrated auth.
# sql => always use IQ_DB_USER/IQ_DB_PASSWORD.
# windows => always use Trusted_Connection=yes.
IQ_DB_AUTH_MODE=auto
IQ_DB_USER=sa
IQ_DB_PASSWORD=your_password_here
IQ_DB_DRIVER=ODBC Driver 18 for SQL Server
# SECURITY: true accepts ANY server certificate (TrustServerCertificate=yes), which still encrypts
# traffic but leaves it open to man-in-the-middle attacks. Kept true for backward compatibility with
# dev/self-signed servers; set false for Azure SQL / production (it presents a trusted certificate).
IQ_DB_TRUST_CERT=true
# Dashboard query timeout in seconds (applied to every pooled connection). The AI page keeps its own 30s limit.
IQ_DB_QUERY_TIMEOUT_SECONDS=60
# Connection pool: persistent connections and seconds to wait for a free one (5 extra overflow connections are allowed).
# Connections are pinged before use and recycled every 30 minutes.
IQ_DB_POOL_SIZE=5
IQ_DB_POOL_TIMEOUT_SECONDS=30
# Seconds Streamlit caches query results (Refresh/clear_data_cache() drops them sooner).
IQ_CACHE_TTL_SECONDS=300

# Data source mode (required): all app datasets are read from IQ_SOURCE_TABLE.
IQ_SOURCE_MODE=flat-table

# Set true to use the synthetic demo_data.csv instead of connecting to SQL Server.
# Demo mode never reads from the database.
IQ_DEMO_MODE=false
IQ_DEMO_CSV=demo_data.csv
# Set these only for a deliberately installation-selected database sample.
IQ_SAMPLE_INSTALLATIONS=0
IQ_PURCHASE_DATE_IS_PROXY=false
# Ship date defaults to PurchaseDate (warranty start), a PROXY for the real shipment date.
# Keep true so the UI labels shipping-to-installation results as proxy-based; set false only
# after IQ_COL_SHIPPED_AT points to a genuine shipment-date column.
IQ_SHIPPED_AT_IS_PROXY=true
# Customer size = devices per company (IQ_COL_CUSTOMER) bucketed by these ascending edges.
# '10,100' => Small (<10), Medium (10-99), Large (100+). No schema change needed.
IQ_CUSTOMER_SIZE_EDGES=10,100
# OPTIONAL extra, off by default and not required by any page: CSV with columns month,value
# (one row per month) loaded by insightquest.data.load_market_series. Leave empty to disable.
# Markets are normally territories and product types, answered from purchase history.
IQ_MARKET_CSV=

# Source table can be qualified as schema.table and support spaces.
IQ_SOURCE_TABLE=dbo.Insight Project
# Map these names to columns that exist in the flat table. Empty mappings make
# dependent analyses show a readiness message instead of querying guessed fields.
IQ_COL_DEVICE=Id
IQ_COL_LOCATION=
IQ_COL_INSTALLED_AT=TankInstallDate
IQ_COL_CUSTOMER=CompanyId
IQ_COL_LATITUDE=Latitude
IQ_COL_LONGITUDE=Longitude
# Territory comes from Device->Ownership->Company->Territory already in the flat table.
IQ_COL_TERRITORY=Territory
IQ_COL_SALES_DATE=PurchaseDate
IQ_COL_SALES_AMOUNT=
# Proxy: PurchaseDate (warranty start). See IQ_SHIPPED_AT_IS_PROXY.
IQ_COL_SHIPPED_AT=PurchaseDate
IQ_COL_SHIPPING_KEY=Id
IQ_COL_CUSTOMER_SIZE=
# Product type (DeviceType) also defines inventory: on hand = devices with NO install date.
IQ_COL_PRODUCT_TYPE=DeviceType
IQ_COL_RATE_DENOMINATOR=
IQ_COL_MARKET_INDICATOR=
IQ_COL_MARKET_INDICATOR_AT=
IQ_COL_INVENTORY_ITEM=
IQ_COL_INVENTORY_AS_OF=
IQ_COL_INVENTORY_ON_HAND=
IQ_COL_INVENTORY_DEMAND=
IQ_COL_REPLENISHMENT_DAYS=
IQ_COL_REORDER_POINT=
IQ_COL_MAX_STOCK=

# OpenAI (private fixed-label mode works without external-data opt-in)
IQ_OPENAI_API_KEY=
IQ_OPENAI_MODEL=gpt-4o-mini
# Guided mode sends approved questions and, separately, approved safe aggregates.
# Review your organization's policy/provider terms before enabling.
IQ_AI_ALLOW_EXTERNAL_DATA=false
# Database mode only: attest that IQ_DB_* uses a SELECT-only account restricted
# to IQ_SOURCE_TABLE (prefer an authorized view). Never use sa for guided mode.
# This flag does not grant/restrict permissions; enforce them in SQL Server.
IQ_AI_DB_READ_ONLY_CONFIRMED=false
