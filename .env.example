IQ_DB_SERVER=localhost
IQ_DB_PORT=1433
IQ_DB_NAME=otodatawebportal_dev
# auto => SQL auth when IQ_DB_USER is set, otherwise Windows integrated auth.
# sql => always use IQ_DB_USER/IQ_DB_PASSWORD.
# windows => always use Trusted_Connection=yes.
IQ_DB_AUTH_MODE=auto
IQ_DB_USER=sa
IQ_DB_PASSWORD=your_password_here
IQ_DB_DRIVER=ODBC Driver 18 for SQL Server
IQ_DB_TRUST_CERT=true

# Optional legacy single-table settings (not used by default query path)
IQ_SOURCE_TABLE=MonitorInstallations
IQ_COL_DEVICE=MonitorName
IQ_COL_LOCATION=DeviceLocation
IQ_COL_INSTALLED_AT=InstalledAt
IQ_COL_CUSTOMER=CustomerName

# Optional: use these when latitude/longitude exist as separate numeric columns
IQ_COL_LATITUDE=
IQ_COL_LONGITUDE=

# Optional: custom SQL for full control.
# It must return these aliases:
# device_name, customer_name, device_location, installed_at, latitude, longitude
IQ_MAP_SQL=

# Optional: custom SQL for trend/projection.
# It must return these aliases:
# installed_at, customer_name
IQ_TREND_SQL=
